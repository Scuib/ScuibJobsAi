# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Phase 2: Supabase (leave blank to use InMemoryStore) ──────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Phase 2: Handoff endpoint (leave blank to write to file) ──────────────────
# Point this to the Backend_api's ingestion endpoint:
# e.g. http://localhost:8000/api/jobs/ingest/
HANDOFF_ENDPOINT_URL=
HANDOFF_API_KEY=
HANDOFF_FILE_PATH=handoff_output.jsonl  # used when HANDOFF_ENDPOINT_URL is not set

# ── Ingestion config ──────────────────────────────────────────────────────────
# Queries and Locations (comma-separated lists)
INGEST_QUERIES=customer service,virtual assistant,data entry,graphics designer,motion designer,web designer,sales representative,marketing,accounting,software engineer
INGEST_LOCATIONS=Nigeria
TARGET_JOB_COUNT=200

# Sources to use (comma-separated): workable, myjobmag, fuzu, jobgurus, jobberman
INGEST_SOURCES=workable,myjobmag,fuzu,jobgurus,jobberman

# JSearch API (RapidAPI) — covers Indeed, LinkedIn, Glassdoor
JSEARCH_API_KEY=
JSEARCH_PAGES=10

# Adzuna API (Free Tier: 250 calls/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_PAGES=5

# Recency Filter: today | 3days | week | month
DATE_POSTED_FILTER=week

# ── Parser config ─────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash   # swap to gemini-2.5-pro for higher accuracy
GEMINI_FALLBACK_MODEL=gemini-2.5-pro
GROQ_API_KEY=                  # Groq fallback after Gemini (get at https://console.groq.com)
GROQ_MODEL=llama-3.3-70b-versatile  # llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
REQUIRE_APPLICATION_LINK=true  # skip handoff for jobs with no apply URL (brand safety)
MAX_JOB_AGE_DAYS=0  # 0 = no limit: hand off all dated jobs, users filter by posted_date in UI. Set N to skip jobs posted >N days ago.
FETCH_TIMEOUT_SECONDS=600  # max seconds for the fetch phase; hanging boards are abandoned, run proceeds with what arrived.
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.9  # leave blank or set to auto-approve high confidence jobs

# ── Concurrency & Resilience ──────────────────────────────────────────────────
MAX_CONCURRENT_PARSES=15
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN=60
RATE_LIMIT_REQUESTS_PER_MINUTE=60
